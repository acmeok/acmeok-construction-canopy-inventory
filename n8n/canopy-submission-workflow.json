        "url": "=https://content.airtable.com/v0/appAKZswA7WRzjVl2/{{ $('Plan Uploads').first().json.recordId }}/{{ encodeURIComponent('Canopy ID Photo') }}/uploadAttachment",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contentType: 'image/jpeg', filename: 'canopy-id.jpg', file: $('Webhook').first().json.body.canopy_id_photo }) }}",
        "options": {}
