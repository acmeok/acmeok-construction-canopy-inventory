{
  "name": "Canopy Submission to Airtable",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "canopy-submit",
      "parameters": {
        "httpMethod": "POST",
        "path": "canopy-submit",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "c0000001-0000-4000-8000-000000000001",
      "position": [
        240,
        0
      ]
    },
    {
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst sid = String(b.submission_id || '');\nif (!/^[A-Za-z0-9-]{8,64}$/.test(sid)) throw new Error('Invalid submission_id');\nif (!String(b.worker_name || '').trim()) throw new Error('Missing worker_name');\nfor (const k of ['canopy_id_photo', 'width_photo', 'length_photo']) {\n  if (typeof b[k] !== 'string' || b[k].length < 100) throw new Error('Missing ' + k);\n  if (b[k].length > 6500000) throw new Error(k + ' is too large');\n}\nreturn [{ json: { submission_id: sid, worker_name: String(b.worker_name).trim(), formula: '{Submission ID}=\"' + sid + '\"' } }];"
      },
      "id": "c0000002-0000-4000-8000-000000000001",
      "position": [
        480,
        0
      ]
    },
    {
      "name": "Find Existing Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "airtableOAuth2Api": {
          "id": "T0nfs4Xj1llRPIhl",
          "name": "taha@acmeok.com"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/appAKZswA7WRzjVl2/tblvYdjqwYyIF6S8f?maxRecords=1&filterByFormula={{ encodeURIComponent($json.formula) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableOAuth2Api",
        "options": {}
      },
      "id": "c0000003-0000-4000-8000-000000000001",
      "position": [
        720,
        0
      ]
    },
    {
      "name": "Row Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "rowexists",
              "leftValue": "={{ $json.records.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0000004-0000-4000-8000-000000000001",
      "position": [
        960,
        0
      ]
    },
    {
      "name": "Create Airtable Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "airtableOAuth2Api": {
          "id": "T0nfs4Xj1llRPIhl",
          "name": "taha@acmeok.com"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/appAKZswA7WRzjVl2/tblvYdjqwYyIF6S8f",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { \"Worker Name\": $('Validate Request').first().json.worker_name, \"Submitted At\": $now.setZone('America/Chicago').toFormat('M/d/yyyy h:mma').toLowerCase(), \"Submission ID\": $('Validate Request').first().json.submission_id, \"Status\": \"Incomplete\" } }) }}",
        "options": {}
      },
      "id": "c0000005-0000-4000-8000-000000000001",
      "position": [
        1200,
        0
      ]
    },
    {
      "name": "Plan Uploads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const j = $input.first().json;\nif (j.records) {\n  const r = j.records[0];\n  const has = (f) => (r.fields[f] || []).length > 0;\n  return [{ json: { recordId: r.id, needCanopy: !has('Canopy ID Photo'), needWidth: !has('Width Photo'), needLength: !has('Length Photo') } }];\n}\nreturn [{ json: { recordId: j.id, needCanopy: true, needWidth: true, needLength: true } }];"
      },
      "id": "c0000006-0000-4000-8000-000000000001",
      "position": [
        1440,
        0
      ]
    },
    {
      "name": "Need Canopy ID Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needcanopyidphoto",
              "leftValue": "={{ $('Plan Uploads').first().json.needCanopy }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0000007-0000-4000-8000-000000000001",
      "position": [
        1680,
        0
      ]
    },
